    @discord.ui.button(label="Месяц", style=discord.ButtonStyle.secondary, row=0)
    async def b4(self, i, b):
        n = datetime.now(timezone.utc)
        await i.response.send_modal(ModSearchModal(n - timedelta(days=30), n, "Месяц", self.user))

    @discord.ui.button(label="Другое", style=discord.ButtonStyle.danger, row=1)
    async def b5(self, i, b):
        class CustomDateModal(discord.ui.Modal, title='Свой период'):
            d1 = discord.ui.TextInput(label='Дата С (ДД.ММ.ГГГГ)', placeholder='01.11.2026', required=True)
            d2 = discord.ui.TextInput(label='Дата ПО (ДД.ММ.ГГГГ)', placeholder='13.11.2026', required=True)
            mod = discord.ui.TextInput(label='Ник модератора', placeholder='Пусто = все', required=False)
            async def on_submit(self, modal_interaction):
                await modal_interaction.response.defer(ephemeral=True)
                try:
                    sd = datetime.strptime(self.d1.value, '%d.%m.%Y').replace(hour=0, minute=0, second=0, tzinfo=timezone.utc)
                    ed = datetime.strptime(self.d2.value, '%d.%m.%Y').replace(hour=23, minute=59, second=59, tzinfo=timezone.utc)
                except ValueError:
                    await modal_interaction.followup.send('❌ Формат даты: ДД.ММ.ГГГГ', ephemeral=True); return
                await log_action(modal_interaction.user, "Свой период", f"С: {self.d1.value} По: {self.d2.value}")
                data = await fetch_logs(modal_interaction, sd, ed, mod_filter=self.mod.value.strip().lower())
                p_name = f"{self.d1.value} - {self.d2.value}"
                await modal_interaction.followup.send(embed=LogView(data, p_name, modal_interaction.user).build_embed(), view=LogView(data, p_name, modal_interaction.user), ephemeral=True)
        await i.response.send_modal(CustomDateModal())

    @discord.ui.button(label="🔍 Поиск по игроку", style=discord.ButtonStyle.blurple, row=1)
    async def b6(self, i, b): 
