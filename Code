    @discord.ui.button(label="Вчера", style=discord.ButtonStyle.primary, row=0)
    async def b2(self, i, b):
        n = datetime.now(timezone.utc)
        e = n.replace(hour=0, minute=0, second=0, microsecond=0)
        await i.response.send_modal(ModSearchModal(e - timedelta(days=1), e, "Вчера", self.user))

    @discord.ui.button(label="Неделя", style=discord.ButtonStyle.primary, row=0)
